{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "sceneforge-classroom"
    },
    "venueId": {
      "type": "string",
      "enum": [
        "bo-live-house",
        "ufo-terminal"
      ]
    },
    "cameraId": {
      "type": "string",
      "minLength": 1
    },
    "screen": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "fit": {
          "type": "string",
          "enum": [
            "contain",
            "cover"
          ]
        },
        "flipX": {
          "type": "boolean"
        },
        "flipY": {
          "type": "boolean"
        }
      },
      "required": [
        "fit",
        "flipX",
        "flipY"
      ],
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "properties": {
        "corners": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "grid",
            "content",
            "blackout"
          ]
        }
      },
      "required": [
        "corners",
        "mode"
      ],
      "additionalProperties": false
    },
    "cueIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "mediaName": {
      "type": "string",
      "maxLength": 300
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "venueId",
    "cameraId",
    "screen",
    "mapping",
    "projection",
    "cueIndex",
    "mediaName",
    "notes"
  ],
  "additionalProperties": false
}
